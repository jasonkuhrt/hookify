{
  "name": "hookify",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Jason Kuhrt",
    "url": "https://kuhrt.me"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jasonkuhrt/hookify.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "install:ci": "bun install --frozen-lockfile",
    "format": "oxfmt --write .",
    "check:format": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "bun test",
    "check": "bun run check:format && bun run lint && bun run test"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.55.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.6",
  "trustedDependencies": [
    "oxfmt"
  ]
}
