{
  "name": "@hookify/workspace",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Jason Kuhrt",
    "url": "https://kuhrt.me"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jasonkuhrt/hookify.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "install:ci": "bun install --frozen-lockfile",
    "install:codex": "bun run ./scripts/install-codex.ts",
    "build:plugin-claude": "bun build plugins/hookify-claude/hooks/dispatch-claude.ts --target=node --format=esm --outfile=plugins/hookify-claude/hooks/dispatch-claude.mjs",
    "build:plugin-codex": "bun build plugins/hookify/hooks/dispatch-codex.ts --target=node --format=esm --outfile=plugins/hookify/hooks/dispatch-codex.mjs",
    "build:plugins": "bun run build:plugin-claude && bun run build:plugin-codex",
    "check:plugin-claude": "bun build plugins/hookify-claude/hooks/dispatch-claude.ts --target=node --format=esm --outfile=/tmp/hookify-dispatch-claude.mjs && diff -u plugins/hookify-claude/hooks/dispatch-claude.mjs /tmp/hookify-dispatch-claude.mjs",
    "check:plugin-codex": "bun build plugins/hookify/hooks/dispatch-codex.ts --target=node --format=esm --outfile=/tmp/hookify-dispatch-codex.mjs && diff -u plugins/hookify/hooks/dispatch-codex.mjs /tmp/hookify-dispatch-codex.mjs",
    "check:plugins": "bun run check:plugin-claude && bun run check:plugin-codex",
    "format": "oxfmt --write .",
    "check:format": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "bun test",
    "check": "bun run check:format && bun run lint && bun run check:plugins && bun run test"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.55.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.6"
  },
  "packageManager": "bun@1.3.6",
  "trustedDependencies": [
    "oxfmt"
  ]
}
